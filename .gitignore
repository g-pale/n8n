# Docker override файлы (могут содержать локальные настройки)
# Эти файлы создаются автоматически или вручную для локальных переопределений
docker-compose.override.yml
docker-compose.local.yml

# Локальные конфигурации с реальными данными (создаются на сервере)
docker-compose.ip.yml
docker-compose.http.yml.bak

# Системные файлы
.DS_Store
.DS_Store?
._*

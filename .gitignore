.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Python (если используется)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Node.js (если используется)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
